<Window x:Class="GuiasMadeira.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guias Madeira" Icon="/Resources/logo.png"
        MinHeight="620" MinWidth="860"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" Panel.ZIndex="1">
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Top" Margin="0,32,0,18" HorizontalAlignment="Center">
                    <Image Source="/Resources/logo_branco.png" Height="128" Stretch="Uniform" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                </StackPanel>
                <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource SidebarBorderBrush}" Margin="26,0,26,24"/>

                <StackPanel DockPanel.Dock="Bottom">
                    <Rectangle Height="1" Fill="{StaticResource SidebarBorderBrush}" Margin="20,4,20,10"/>
                    <Button Content="Sair" Style="{StaticResource SidebarGhostButton}" Click="Sair_Click"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Gestão" Foreground="{StaticResource SidebarTextMutedBrush}"
                               FontSize="11" FontWeight="SemiBold" Margin="30,0,0,8"/>
                    <RadioButton x:Name="NavPesquisar" GroupName="MainNav" Style="{StaticResource NavItem}"
                                 Content="Gerir guias" Checked="NavPesquisar_Checked"/>

                    <TextBlock Text="Dados" Foreground="{StaticResource SidebarTextMutedBrush}"
                               FontSize="11" FontWeight="SemiBold" Margin="30,24,0,8"/>
                    <RadioButton x:Name="NavDestinatarios" GroupName="MainNav" Style="{StaticResource NavItem}"
                                 Checked="NavDestinatarios_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Destinatários" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource NavBadge}">
                                <TextBlock x:Name="DestinatariosCountText" Style="{StaticResource NavBadgeText}" Text="…"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavProprietarios" GroupName="MainNav" Style="{StaticResource NavItem}"
                                 Checked="NavProprietarios_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Proprietários" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource NavBadge}">
                                <TextBlock x:Name="ProprietariosCountText" Style="{StaticResource NavBadgeText}" Text="…"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavRolarias" GroupName="MainNav" Style="{StaticResource NavItem}"
                                 Checked="NavRolarias_Checked">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Rolarias" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource NavBadge}">
                                <TextBlock x:Name="RolariasCountText" Style="{StaticResource NavBadgeText}" Text="…"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavImportarCodigosBarras" GroupName="MainNav" Style="{StaticResource NavItem}"
                                 Content="Importar vinhetas" Checked="NavImportarCodigosBarras_Checked"/>
                    <RadioButton x:Name="NavUgf" GroupName="MainNav" Style="{StaticResource NavItem}"
                                 Content="Limites UGF" Checked="NavUgf_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
