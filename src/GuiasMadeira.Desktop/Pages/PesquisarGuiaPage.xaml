<Page x:Class="GuiasMadeira.Desktop.Pages.PesquisarGuiaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gerir guias">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Gestão" Style="{StaticResource BreadcrumbLink}"/>
                    <Path Style="{StaticResource BreadcrumbSeparator}"/>
                    <TextBlock Text="Guias" Style="{StaticResource BreadcrumbLink}"/>
                    <Path Style="{StaticResource BreadcrumbSeparator}"/>
                    <TextBlock Text="Gerir guias" Style="{StaticResource BreadcrumbCurrent}"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Gerir guias" Style="{StaticResource PageTitle}"/>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" Click="CriarGuia_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAdd}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Criar guia" Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Path Style="{StaticResource FieldIconStroke}" Data="{StaticResource IconSearch}"/>
                        <TextBlock Text="Pesquisar por nº da guia, destinatário, NIF, proprietário ou fornecedor" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </StackPanel>
                    <TextBox x:Name="PesquisaBox" Margin="0,0,0,12" TextChanged="Pesquisa_TextChanged"/>
                </StackPanel>

                <Border x:Name="ListaEmptyState" Grid.Row="3" Style="{StaticResource EmptyState}" VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconEmptyBox}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Ainda não há guias registadas." Style="{StaticResource HelperText}" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="ListaGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="{StaticResource BackgroundBrush}"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="320"
                          ColumnHeaderStyle="{StaticResource ListGridHeader}" CellStyle="{StaticResource ListGridCell}"
                          RowStyle="{StaticResource ListGridRow}"
                          HeadersVisibility="Column" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nº guia" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Destinatário" Binding="{Binding DestinatarioNome}" Width="2*"/>
                        <DataGridTextColumn Header="Proprietário" Binding="{Binding ProprietarioNome}" Width="2*"/>
                        <DataGridTextColumn Header="Rolaria" Binding="{Binding RolariaTipo}" Width="*"/>
                        <DataGridTextColumn Header="Fornecedor" Binding="{Binding Fornecedor}" Width="*"/>
                        <DataGridTextColumn Header="Criada em" Binding="{Binding CriadoEm, StringFormat='dd/MM/yyyy HH:mm'}" Width="130"/>
                        <DataGridTemplateColumn Header="" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostIconButton}" ToolTip="Pré-visualizar" Click="PreVisualizar_Click">
                                            <Path Data="{StaticResource IconPrinter}" Fill="{StaticResource TextMutedBrush}"
                                                  Width="15" Height="15" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostIconButton}" ToolTip="Editar" Click="Editar_Click">
                                            <Path Data="{StaticResource IconEdit}" Fill="{StaticResource TextMutedBrush}"
                                                  Width="15" Height="15" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource GhostIconButton}" ToolTip="Apagar" Click="Apagar_Click">
                                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource ErrorBrush}"
                                                  Width="15" Height="15" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
