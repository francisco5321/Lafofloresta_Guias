<Page x:Class="GuiasMadeira.Desktop.Pages.PesquisarGuiaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Pesquisar Guia">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Pesquisar Guia" Style="{StaticResource PageTitle}"/>

                <TextBlock Text="NÚMERO DA GUIA" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="GuiaCombo" IsTextSearchEnabled="True"/>

                <Button x:Name="PesquisarButton" Content="Pesquisar" Style="{StaticResource PrimaryButton}"
                        Margin="0,8,0,0" Click="Pesquisar_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
