<Page x:Class="GuiasMadeira.Desktop.Pages.GuiaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Nova Guia">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Nova Guia" Style="{StaticResource PageTitle}"/>
                <TextBlock Style="{StaticResource HelperText}" Margin="0,-12,0,20"
                           Text="Escolha o destinatário, o proprietário, o código de barras e a rolaria — o resto dos dados já vem da base de dados."/>

                <TextBlock Text="DESTINATÁRIO" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DestinatarioCombo" DisplayMemberPath="Nome" IsTextSearchEnabled="True"/>

                <TextBlock Text="PROPRIETÁRIO" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ProprietarioCombo" DisplayMemberPath="Nome" IsTextSearchEnabled="True"/>

                <TextBlock Text="CÓDIGO DE BARRAS" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CodigoBarraCombo" DisplayMemberPath="Codigo" IsTextSearchEnabled="True"/>

                <TextBlock Text="TIPO DE ROLARIA" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="RolariaCombo" DisplayMemberPath="Tipo" IsTextSearchEnabled="True"/>

                <TextBlock Text="FORNECEDOR" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="FornecedorBox"/>

                <Button x:Name="ImprimirButton" Content="Imprimir / Pré-visualizar Guia"
                        Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Click="Imprimir_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
