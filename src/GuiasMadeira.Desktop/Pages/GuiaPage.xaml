<Page x:Class="GuiasMadeira.Desktop.Pages.GuiaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Nova guia">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="560" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <StackPanel VerticalAlignment="Center">

                <!-- Breadcrumb -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Gestão" Style="{StaticResource BreadcrumbLink}"/>
                    <Path Style="{StaticResource BreadcrumbSeparator}"/>
                    <TextBlock Text="Guias" Style="{StaticResource BreadcrumbLink}"/>
                    <Path Style="{StaticResource BreadcrumbSeparator}"/>
                    <TextBlock x:Name="BreadcrumbCurrentText" Text="Nova guia" Style="{StaticResource BreadcrumbCurrent}"/>
                </StackPanel>

                <!-- Toast de confirmação -->
                <Border x:Name="ToastBorder" Style="{StaticResource Toast}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ToastText" Text="Guia criada" Foreground="{StaticResource AccentPressedBrush}" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="PageTitleText" Text="Nova guia" Style="{StaticResource PageTitle}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource HelperText}" Margin="0,0,0,20"
                           Text="Escolhe o destinatário, o proprietário, o número de certificado e a rolaria — a vinheta é atribuída automaticamente e o resto dos dados já vem da base de dados."/>

                <!-- Barra de progresso -->
                <Border Style="{StaticResource ProgressTrack}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ProgressFillColumn" Width="0*"/>
                            <ColumnDefinition x:Name="ProgressRemainderColumn" Width="5*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ProgressFill}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="ProgressText" Style="{StaticResource HelperText}" Margin="0,6,0,20"
                           Text="0 de 5 campos preenchidos"/>

                <!-- Destinatário -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconPerson}"/>
                    <TextBlock Text="Destinatário" Style="{StaticResource FieldLabel}" Margin="0"/>
                </StackPanel>
                <ComboBox x:Name="DestinatarioCombo" Style="{StaticResource SuccessComboBox}"
                          DisplayMemberPath="Nome" IsTextSearchEnabled="True" SelectionChanged="Campo_Changed"/>
                <Border x:Name="DestinatarioEmptyState" Style="{StaticResource EmptyState}">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconEmptyBox}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Ainda não há destinatários registados." Style="{StaticResource HelperText}"
                                   TextAlignment="Center" Margin="0,0,0,12"/>
                        <Button Content="Adicionar destinatário" Style="{StaticResource SecondaryButton}" Click="AdicionarDestinatario_Click"/>
                    </StackPanel>
                </Border>

                <!-- Proprietário -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconTree}"/>
                    <TextBlock Text="Proprietário" Style="{StaticResource FieldLabel}" Margin="0"/>
                </StackPanel>
                <ComboBox x:Name="ProprietarioCombo" Style="{StaticResource SuccessComboBox}"
                          DisplayMemberPath="Nome" IsTextSearchEnabled="True" SelectionChanged="Campo_Changed"/>
                <Border x:Name="ProprietarioEmptyState" Style="{StaticResource EmptyState}">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconEmptyBox}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Ainda não há proprietários registados." Style="{StaticResource HelperText}"
                                   TextAlignment="Center" Margin="0,0,0,12"/>
                        <Button Content="Adicionar proprietário" Style="{StaticResource SecondaryButton}" Click="AdicionarProprietario_Click"/>
                    </StackPanel>
                </Border>

                <!-- Número de certificado (a vinheta concreta é atribuída automaticamente) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconBarcode}"/>
                    <TextBlock Text="Número de certificado" Style="{StaticResource FieldLabel}" Margin="0"/>
                </StackPanel>
                <ComboBox x:Name="CertificadoCombo" Style="{StaticResource SuccessComboBox}"
                          DisplayMemberPath="Rotulo" IsTextSearchEnabled="True" SelectionChanged="Campo_Changed"/>
                <Border x:Name="CertificadoEmptyState" Style="{StaticResource EmptyState}">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconEmptyBox}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Ainda não há certificados com vinhetas disponíveis." Style="{StaticResource HelperText}"
                                   TextAlignment="Center" Margin="0,0,0,12"/>
                        <Button Content="Importar vinhetas" Style="{StaticResource SecondaryButton}" Click="ImportarCodigosBarras_Click"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="CertificadoUgfError" Style="{StaticResource InlineError}" Margin="0,-12,0,16"/>

                <!-- Rolaria -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconRecycle}"/>
                    <TextBlock Text="Tipo de rolaria" Style="{StaticResource FieldLabel}" Margin="0"/>
                </StackPanel>
                <ComboBox x:Name="RolariaCombo" Style="{StaticResource SuccessComboBox}"
                          DisplayMemberPath="Tipo" IsTextSearchEnabled="True" SelectionChanged="Campo_Changed"/>
                <Border x:Name="RolariaEmptyState" Style="{StaticResource EmptyState}">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconEmptyBox}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Ainda não há tipos de rolaria registados." Style="{StaticResource HelperText}"
                                   TextAlignment="Center" Margin="0,0,0,12"/>
                        <Button Content="Adicionar rolaria" Style="{StaticResource SecondaryButton}" Click="AdicionarRolaria_Click"/>
                    </StackPanel>
                </Border>

                <!-- Fornecedor (opcional) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconTruck}"/>
                    <TextBlock Text="Fornecedor (opcional)" Style="{StaticResource FieldLabel}" Margin="0"/>
                </StackPanel>
                <TextBox x:Name="FornecedorBox" TextChanged="Campo_Changed"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                    <Button x:Name="ImprimirButton" Style="{StaticResource PrimaryButton}"
                            Click="Imprimir_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPrinter}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ImprimirButtonText" Text="Pré-visualizar guia" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelarEdicaoButton" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" Visibility="Collapsed" Click="CancelarEdicao_Click"/>
                </StackPanel>
                <TextBlock x:Name="MicrocopyText" Style="{StaticResource HelperText}" TextAlignment="Center" Margin="0,8,0,0"/>

            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
