<Page x:Class="GuiasMadeira.Desktop.Pages.RolariaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Rolarias">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Nova Rolaria" Style="{StaticResource PageTitle}"/>

                <TextBlock Text="TIPO DE ROLARIA" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TipoBox"/>

                <Button x:Name="GuardarButton" Content="GUARDAR" Style="{StaticResource PrimaryButton}"
                        Margin="0,8,0,0" Click="Guardar_Click"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Page>
