<Page x:Class="GuiasMadeira.Desktop.Pages.UgfPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:GuiasMadeira.Desktop.Converters"
      Title="Limites UGF">
    <Page.Resources>
        <converters:EstadoUgfCorConverter x:Key="EstadoUgfCorConverter"/>
    </Page.Resources>
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Dados" Style="{StaticResource BreadcrumbLink}"/>
            <Path Style="{StaticResource BreadcrumbSeparator}"/>
            <TextBlock Text="Limites UGF" Style="{StaticResource BreadcrumbLink}"/>
            <Path Style="{StaticResource BreadcrumbSeparator}"/>
            <TextBlock x:Name="BreadcrumbCurrentText" Text="Novo UGF" Style="{StaticResource BreadcrumbCurrent}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}" Width="Auto" Height="Auto" HorizontalAlignment="Stretch">
                    <StackPanel>

                        <Border x:Name="ToastBorder" Style="{StaticResource Toast}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ToastText" Text="UGF guardado" Foreground="{StaticResource AccentPressedBrush}" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="FormTitleText" Text="Novo UGF" Style="{StaticResource PageTitle}"/>
                        <TextBlock Style="{StaticResource HelperText}" Margin="0,-8,0,16"
                                   Text="Escolhe um UGF existente na lista, ou escreve um código novo para criar um."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconTag}"/>
                            <TextBlock Text="Código UGF" Style="{StaticResource FieldLabel}" Margin="0"/>
                        </StackPanel>
                        <ComboBox x:Name="CodigoCombo" Style="{StaticResource SuccessEditableComboBox}"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  SelectionChanged="CodigoCombo_SelectionChanged"/>
                        <TextBlock x:Name="CodigoError" Style="{StaticResource InlineError}" Margin="0,-12,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconTruck}"/>
                            <TextBlock Text="Toneladas Certificado (inserir à mão)" Style="{StaticResource FieldLabel}" Margin="0"/>
                        </StackPanel>
                        <TextBox x:Name="CertificadoBox" Style="{StaticResource SuccessTextBox}" TextChanged="CertificadoBox_TextChanged"/>
                        <TextBlock x:Name="CertificadoError" Style="{StaticResource InlineError}" Margin="0,-12,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconTruck}"/>
                            <TextBlock Text="Valor médio da carga (toneladas, opcional)" Style="{StaticResource FieldLabel}" Margin="0"/>
                        </StackPanel>
                        <TextBox x:Name="CargaMediaBox" TextChanged="CertificadoBox_TextChanged"/>
                        <TextBlock x:Name="CargaMediaError" Style="{StaticResource InlineError}" Margin="0,-12,0,16"/>

                        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,4,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Toneladas Disponíveis" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="DisponivelText" Text="—" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Disponíveis + 20%" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="DisponivelToleranciaText" Text="—" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Estado: " Style="{StaticResource FieldLabel}" Margin="0"/>
                                    <TextBlock x:Name="EstadoText" Text="—" FontWeight="Bold"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Guias possíveis" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="GuiasMaximoText" Text="—" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Guias criadas" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="GuiasCriadasText" Text="—" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Guias restantes" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="GuiasRestantesText" Text="—" FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="GuiasAvisoText" Style="{StaticResource HelperText}"
                                           Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <Button x:Name="GuardarButton" Content="Guardar" Style="{StaticResource PrimaryButton}" Click="Guardar_Click"/>
                            <Button x:Name="CancelarEdicaoButton" Content="Cancelar edição" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Visibility="Collapsed" Click="CancelarEdicao_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource Card}" Width="Auto" Height="Auto"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="UGFs registados" Style="{StaticResource PageTitle}" FontSize="18" Margin="0,0,0,2"/>
                        <TextBlock Style="{StaticResource HelperText}" Text="Duplo clique numa linha para ver e editar os dados desse UGF."/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Path Style="{StaticResource FieldIconStroke}" Data="{StaticResource IconSearch}"/>
                            <TextBlock Text="Pesquisar" Style="{StaticResource FieldLabel}" Margin="0"/>
                        </StackPanel>
                        <TextBox x:Name="PesquisaBox" Margin="0,0,0,12" TextChanged="Pesquisa_TextChanged"/>
                    </StackPanel>

                    <Border x:Name="ListaEmptyState" Grid.Row="2" Style="{StaticResource EmptyState}" VerticalAlignment="Top">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconEmptyBox}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Ainda não há UGFs registados." Style="{StaticResource HelperText}" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="ListaGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="{StaticResource BackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="260"
                              ColumnHeaderStyle="{StaticResource ListGridHeader}" CellStyle="{StaticResource ListGridCell}"
                              RowStyle="{StaticResource ListGridRow}"
                              HeadersVisibility="Column" RowHeaderWidth="0"
                              MouseDoubleClick="ListaGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="*"/>
                            <DataGridTextColumn Header="Certificado (ton)" Binding="{Binding ToneladasCertificado, StringFormat='0.000'}" Width="*"/>
                            <DataGridTextColumn Header="Disponível" Binding="{Binding ToneladasDisponiveis, StringFormat='0.000'}" Width="*"/>
                            <DataGridTextColumn Header="Disponível +20%" Binding="{Binding ToneladasDisponiveisComTolerancia, StringFormat='0.000'}" Width="*"/>
                            <DataGridTextColumn Header="Guias" Binding="{Binding GuiasRotulo}" Width="80"/>
                            <DataGridTemplateColumn Header="Estado" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Estado}" FontWeight="Bold"
                                                   Foreground="{Binding Estado, Converter={StaticResource EstadoUgfCorConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostIconButton}" ToolTip="Importar entrada da fábrica" Click="ImportarEntrada_Click">
                                                <Path Data="{StaticResource IconAdd}" Fill="{StaticResource AccentBrush}"
                                                      Width="15" Height="15" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostIconButton}" ToolTip="Editar" Click="Editar_Click">
                                                <Path Data="{StaticResource IconEdit}" Fill="{StaticResource TextMutedBrush}"
                                                      Width="15" Height="15" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource GhostIconButton}" ToolTip="Apagar" Click="Apagar_Click">
                                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource ErrorBrush}"
                                                      Width="15" Height="15" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
