<Page x:Class="GuiasMadeira.Desktop.Pages.ImportarCodigosBarrasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Importar vinhetas">
    <Page.Resources>
        <Style x:Key="ImportGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ImportGridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Width="Auto" Height="Auto" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="Dados" Style="{StaticResource BreadcrumbLink}"/>
                    <Path Style="{StaticResource BreadcrumbSeparator}"/>
                    <TextBlock Text="Códigos de barras" Style="{StaticResource BreadcrumbLink}"/>
                    <Path Style="{StaticResource BreadcrumbSeparator}"/>
                    <TextBlock Text="Importar vinhetas" Style="{StaticResource BreadcrumbCurrent}"/>
                </StackPanel>

                <Border x:Name="ToastBorder" Grid.Row="1" Style="{StaticResource Toast}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ToastText" Text="Códigos importados" Foreground="{StaticResource AccentPressedBrush}" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconBarcode}" Width="20" Height="20"/>
                    <TextBlock Text="Importar vinhetas (códigos de barras)" Style="{StaticResource PageTitle}" Margin="0"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="SelecionarFicheiroButton" Content="Selecionar ficheiro Excel..."
                            Style="{StaticResource SecondaryButton}" Click="SelecionarFicheiro_Click"/>
                    <TextBlock x:Name="FicheiroText" Text="Nenhum ficheiro selecionado."
                               Style="{StaticResource HelperText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="ResumoText" Grid.Row="4" Style="{StaticResource HelperText}" Margin="0,10,0,10"/>

                <DataGrid x:Name="PreviewGrid" Grid.Row="5" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="{StaticResource BackgroundBrush}"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                          ColumnHeaderStyle="{StaticResource ImportGridHeader}" CellStyle="{StaticResource ImportGridCell}"
                          HeadersVisibility="Column" RowHeaderWidth="0" MinHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Linha" Binding="{Binding Linha}" Width="70"/>
                        <DataGridTextColumn Header="Código de barras" Binding="{Binding Codigo}" Width="*"/>
                        <DataGridTextColumn Header="Nº certificado" Binding="{Binding NumeroCertificado}" Width="*"/>
                        <DataGridTextColumn Header="Nº UGF" Binding="{Binding NumeroUgf}" Width="*"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button x:Name="ImportarButton" Grid.Row="6" Content="Importar" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Margin="0,16,0,0" IsEnabled="False" Click="Importar_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Width="Auto" Height="Auto" HorizontalAlignment="Stretch" Margin="0,24,0,0" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <Border x:Name="VinhetaToastBorder" Style="{StaticResource Toast}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock x:Name="VinhetaToastText" Text="Vinheta atualizada" Foreground="{StaticResource AccentPressedBrush}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Editar vinheta" Style="{StaticResource PageTitle}" FontSize="20"/>
                    <TextBlock x:Name="VinhetaAjudaText" Style="{StaticResource HelperText}" Margin="0,0,0,16"
                               Text="Escolhe uma vinheta na lista ao lado para editar ou apagar."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconBarcode}"/>
                        <TextBlock Text="Código de barras" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </StackPanel>
                    <TextBox x:Name="VinhetaCodigoBox" IsEnabled="False"/>
                    <TextBlock x:Name="VinhetaCodigoError" Style="{StaticResource InlineError}" Margin="0,-12,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconTag}"/>
                        <TextBlock Text="Nº certificado (opcional)" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </StackPanel>
                    <TextBox x:Name="VinhetaNumeroCertificadoBox" IsEnabled="False"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Path Style="{StaticResource FieldIcon}" Data="{StaticResource IconTag}"/>
                        <TextBlock Text="Nº UGF (opcional)" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </StackPanel>
                    <TextBox x:Name="VinhetaNumeroUgfBox" IsEnabled="False"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                        <Button x:Name="VinhetaGuardarButton" Content="Guardar alterações" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Click="VinhetaGuardar_Click"/>
                        <Button x:Name="VinhetaCancelarButton" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Visibility="Collapsed" Click="VinhetaCancelar_Click"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Vinhetas registadas" Style="{StaticResource PageTitle}" FontSize="18" Margin="0,0,0,14"/>

                        <StackPanel Grid.Row="1" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Style="{StaticResource FieldIconStroke}" Data="{StaticResource IconSearch}"/>
                                <TextBlock Text="Pesquisar" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </StackPanel>
                            <TextBox x:Name="VinhetaPesquisaBox" Margin="0,0,0,12" TextChanged="VinhetaPesquisa_TextChanged"/>
                        </StackPanel>

                        <Border x:Name="VinhetaListaEmptyState" Grid.Row="2" Style="{StaticResource EmptyState}" VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconEmptyBox}" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Ainda não há vinhetas importadas." Style="{StaticResource HelperText}" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="VinhetaListaGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  RowBackground="{StaticResource SurfaceBrush}" AlternatingRowBackground="{StaticResource BackgroundBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="220"
                                  ColumnHeaderStyle="{StaticResource ListGridHeader}" CellStyle="{StaticResource ListGridCell}"
                                  RowStyle="{StaticResource ListGridRow}"
                                  HeadersVisibility="Column" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código de barras" Binding="{Binding Codigo}" Width="2*"/>
                                <DataGridTextColumn Header="Nº certificado" Binding="{Binding NumeroCertificado}" Width="*"/>
                                <DataGridTextColumn Header="Nº UGF" Binding="{Binding NumeroUgf}" Width="*"/>
                                <DataGridTemplateColumn Header="" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostIconButton}" ToolTip="Editar" Click="VinhetaEditar_Click">
                                                    <Path Data="{StaticResource IconEdit}" Fill="{StaticResource TextMutedBrush}"
                                                          Width="15" Height="15" Stretch="Uniform"/>
                                                </Button>
                                                <Button Style="{StaticResource GhostIconButton}" ToolTip="Apagar" Click="VinhetaApagar_Click">
                                                    <Path Data="{StaticResource IconTrash}" Fill="{StaticResource ErrorBrush}"
                                                          Width="15" Height="15" Stretch="Uniform"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
